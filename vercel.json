{
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "images": {
    "sizes": [256, 384, 640, 750, 828, 1080, 1200, 1920, 2048, 3840],
    "domains": [],
    "minimumCacheTTL": 60
  },
  "crons": [
    {
      "path": "/api/cron/uptime",
      "schedule": "0 0 * * *"
    }
  ],
  "regions": ["iad1"],
  "public": true,
  "github": {
    "silent": true,
    "autoJobCancelation": true
  }
}
