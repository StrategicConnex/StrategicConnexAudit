# ╔══════════════════════════════════════════════════════════════════╗
# ║  StrategicAudit Pro — Environment Variables                     ║
# ║  Copy this file to .env.local for local development.            ║
# ║  Set these in Vercel Dashboard → Settings → Environment Vars.   ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Supabase (required) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Nombre canónico de la key pública (CS-301). Alias de compatibilidad:
# NEXT_PUBLIC_SUPABASE_ANON_KEY — env.ts acepta una de las dos (al menos una
# requerida); el runtime lee PUBLISHABLE || ANON (src/shared/config/env.ts).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # JWT from Supabase Dashboard → Settings → API
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── AI Models (optional — uses free pool if empty) ───────────────
# ──── IA: OpenRouter (primario) + Groq/Gemini (failover) ───────────────────
# OPENROUTER_API_KEY sigue siendo la ÚNICA clave REQUERIDA de IA. Las de
# failover son OPCIONALES (enmienda anti-monodependencia, decisión owner
# 2026-10-19): sin ellas el pool funciona igual; con ellas, si la cadena
# OpenRouter de la tarea se agota, el router enruta por:
#   GROQ_API_KEY   → api.groq.com/openai/v1 (OpenAI-compatible)
#                    modelo failover: openai/gpt-oss-120b (reasoning_effort low)
#   GEMINI_API_KEY → generativelanguage.googleapis.com/v1beta/openai
#                    modelo failover: gemini-3.8-flash (clave formato AQ.*,
#                    nueva tras el incidente 2026-10-17 de la clave filtrada)
# Ambas verificadas EN VIVO el 2026-10-19 (chat/json_object/tool calling).
# Legados ELIMINADOS y sin consumidor: BEARER_API_KEY, XIAOMI_BASE_URL,
# NVIDIA_API_KEY y el antiguo GEMINI_API_KEY (filtrada). Ver
# tests/integration/AI-CONNECTIONS-REPORT.md.
# OPENROUTER_API_KEY=...
# Opcional (failover):
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AQ....
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── Rate limiting / progreso PDF ─────────────────────────────────
# Sin servicios externos: en producción el rate limit corre sobre la tabla
# Postgres `rate_limit_windows` (ADR-002 enm. 15); fuera de producción, en
# memoria. El progreso de PDF vive en la tabla Postgres `pdf_progress`.
# Override opcional del store (emergencia): RATE_LIMIT_STORE=postgres|memory
# RATE_LIMIT_STORE=

# ─── Vercel Cron (required for /api/cron/* endpoints) ────────────
CRON_SECRET=generate-a-random-secret-here
# Cifrado de secretos en reposo (P1-5, requerido para webhooks/RUM)
# Generar con: openssl rand -hex 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_output_of_openssl_rand_hex_32

# ─── Trigger.dev (optional — background task runner) ──────────────
# TRIGGER_SECRET_KEY=...

# ─── Web Push Notifications (optional) ────────────────────────────
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# ─── SIEM Webhooks (optional) ─────────────────────────────────────
# SIEM_WEBHOOK_SLACK=https://hooks.slack.com/services/...
# SIEM_WEBHOOK_PAGERDUTY=https://events.pagerduty.com/v2/enqueue/...
# SIEM_WEBHOOK_SPLUNK=https://splunk.example.com:8088/services/collector/...
# SIEM_PAGERDUTY_ROUTING_KEY=...
# SIEM_EMAIL_TO=security@empresa.com
# SIEM_EMAIL_FROM=alertas@empresa.com
# ─── Bot bidireccional Slack/Teams (optional, B16) ─────────
# Slack: signing secret de la app — verifica la firma de comandos y botones.
# SLACK_SIGNING_SECRET=...
# Proyectos que el bot puede consultar y acusar (UUIDs separados por comas).
# Sin esta lista el bot no autoriza NINGÚN proyecto (fail-closed).
# SLACK_ALLOWED_PROJECT_IDS=00000000-0000-0000-0000-000000000000
# Teams: HMAC compartido del endpoint de comandos (x-scaudit-signature).
# SCAUDIT_TEAMS_SECRET=...

# ─── Email (Resend) — usado por SIEM email alerts (optional) ──────
# RESEND_API_KEY=re_...

# ─── PostgreSQL SSL (optional — solo si tu proveedor lo requiere) ─
# DB_ALLOW_INSECURE_SSL=true
# SUPABASE_CA_CRT=                # opcional: PEM del CA (tal cual o base64).
#                                 # Por defecto se usa el CA embebido en
#                                 # src/shared/db/supabase-ca.ts (no depende del
#                                 # filesystem del runtime; verificada en
#                                 # workers de Trigger.dev).

# ─── Dev only: saltea autenticación en desarrollo ──────────────────
# ⚠️ NUNCA activar en producción (gateado por NODE_ENV !== 'production')
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true

# ─── Auth / Login (optional) ───────────────────────────────────────
# Emails that bypass the login rate limit (validate-email + callback),
# comma-separated. The owner email is already allowlisted in code.
# AUTH_EMAIL_ALLOWLIST=admin@empresa.com,dev@empresa.com


# ── Sentry (observabilidad, opcional) ─────────────────────────────────────
# DSN público de Sentry (org/project). Sin DSN el SDK queda inactivo: la app
# arranca igual y no se envía nada. Trazas al 10% en producción para no agotar
# la cuota del plan gratuito.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# Session Replay: graba pantalla e interacciones (PII). Desactivado por defecto.
# NEXT_PUBLIC_SENTRY_REPLAY=false

# ── API pública v1 — contrato Newman (CI) — OBLIGATORIA ──────────────────
# Clave `sa_live_...` de la API pública (Developers → API Keys). El job
# `api-contract-test` la lee del secreto de GitHub Actions `SCAUDIT_API_KEY`.
# Es OBLIGATORIA en CI: sin el secreto el job FALLA
# (newman_status=missing_secret), de modo que su ausencia no puede cerrar el
# pipeline en verde. Única excepción: PRs desde forks, donde GitHub no expone
# los secretos del repo y el paso se omite con un `::warning::` visible.
# Configúralo en Settings → Secrets and variables → Actions → New repository
# secret. (En local, para newman manual: exporta SCAUDIT_API_KEY=sa_live_...)
# SCAUDIT_API_KEY=sa_live_...

# ── Contrato en vivo del job `api-contract-test` — target NO productivo ──
# Ese job lanza Newman contra un servidor REAL. Desde 2026-10-10 está
# prohibido apuntarlo a producción: el paso *Guard* FALLA salvo que `TEST_ENV`
# sea `staging` o `test` Y `SCAUDIT_CONTRACT_BASE_URL` apunte a un host que no
# sea de producción (denylist: scaudit.vercel.app, strategicaudit.pro). Ambas
# son *variables* de repositorio, no secretos (una URL no lo es):
# Settings → Secrets and variables → Actions → Variables.
# Sin ellas el job queda en rojo a propósito (fail-closed, nunca un falso verde
# con Newman golpeando producción).
# TEST_ENV=staging
# SCAUDIT_CONTRACT_BASE_URL=https://<tu-entorno-de-staging>

# ── Feature flags (rollout sin desplegar, fail-closed) ────────────────────
# Convención (`src/shared/lib/flags.ts`): FEATURE_<NAME> on/off
# (1/true/on/yes · 0/false/off/no) y FEATURE_<NAME>_ROLLOUT 0..100 para canary
# por usuario (hash estable de name:userId). Sin variable, el flag está OFF.
#
# FEATURE_SCAN_QUEUE        C3/ADR-008: encola el escaneo en `scan_queue`
#                           (Postgres) y lo ejecuta el worker fuera del request
#                           HTTP. Apagado, POST /api/intelligence/runs ejecuta
#                           en línea (comportamiento previo).
# FEATURE_SCAN_QUEUE_ROLLOUT  Porcentaje de usuarios en los que se activa.
# FEATURE_SCAN_QUEUE=0
# FEATURE_SCAN_QUEUE_ROLLOUT=0
# FEATURE_REALTIME_LIVE     ADR-004 (enmienda): Realtime como mecanismo principal de
#   la barra live; el sondeo de 15 s queda como fallback. En componentes cliente
#   la clave debe llevar el prefijo NEXT_PUBLIC_, porque sin el el bundle la
#   sustituye por undefined y el flag quedaria siempre apagado.
# NEXT_PUBLIC_FEATURE_REALTIME_LIVE=0
# NEXT_PUBLIC_FEATURE_REALTIME_LIVE_ROLLOUT=0
