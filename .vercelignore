# ─── Local development & build outputs ──────────────────────────
.next/
node_modules/
out/
dist/
.pnpm-store/

# ─── Environment files (do NOT upload secrets) ──────────────────
.env
.env.local
.env*.local
.env.development

# ─── Tests (not needed in production) ───────────────────────────
e2e/
tests/
__tests__/
*.test.ts
*.spec.ts
playwright.config.ts
vitest.config.ts

# ─── Documentation & assets ─────────────────────────────────────
# NOTE: `docs/` must NOT be ignored. The root docs/*.md files are read at
# build time by the /docs/[...slug] catch-all, and src/app/docs/ provides the
# /docs routes. Ignoring `docs/` silently dropped /docs from production builds
# (gitignore semantics: a bare `docs/` matches the dir at ANY depth, including
# src/app/docs/). Media patterns are root-anchored so public/ assets (PWA
# manifest icons like logo-dark.svg, etc.) still get uploaded.
README.md
/*.md
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.svg
.github/
drizzle/

# ─── Scratch / temp / legacy ────────────────────────────────────
scratch/
backups/
.freebuff/
*.exe
tmp/
temp/

# ─── Coverage reports ───────────────────────────────────────────
coverage/
